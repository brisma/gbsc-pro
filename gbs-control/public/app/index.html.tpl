<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#121315">
<link rel="icon" href="data:,">
<!-- Add to Home Screen (PWA): manifest and icons inline; no service worker on a plain-http LAN address.
     Icon: the wordmark stacked, GBS white + C on the yellow tile over PRO, on #121315 (180 px PNG rendered
     from the SVG once, 16 colours, also in the manifest: the loader must stay in the first 8 KB) -->
<link rel="manifest" href="data:application/manifest+json,%7B%22name%22:%22GBSC%20PRO%22,%22short_name%22:%22GBSC%20PRO%22,%22display%22:%22standalone%22,%22background_color%22:%22%23121315%22,%22theme_color%22:%22%23121315%22,%22start_url%22:%22.%22,%22icons%22:%5B%7B%22src%22:%22data:image/png;base64,%22,%22sizes%22:%22180x180%22,%22type%22:%22image/png%22%7D%5D%7D">
<link rel="apple-touch-icon" href="data:image/png;base64,">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="GBSC PRO">
<title>GBSC PRO</title>
<!-- The loader comes in the first bytes: over the device's WiFi (~25 KB/s) the page takes a few seconds, and the big
     style and script below must not keep the screen blank. The app removes #boot when ready. -->
<style>html,body{margin:0;background:#121315}#boot{position:fixed;inset:0;z-index:99;display:grid;place-content:center;justify-items:center;gap:14px;background:#121315;color:#9a978f;font:600 14px system-ui,-apple-system,sans-serif}#boot svg{width:44px;height:44px;animation:boot 1.1s linear infinite}@keyframes boot{to{transform:rotate(360deg)}}@media (prefers-reduced-motion:reduce){#boot svg{animation:none}}</style>
</head>
<body>
<div id="boot" role="progressbar" aria-label="Loading GBSC PRO"><svg viewBox="0 0 64 64" aria-hidden="true"><path d="M43 23a13 13 0 1 0 0 18" fill="none" stroke="#f6d21a" stroke-width="7" stroke-linecap="round"/></svg>Loading GBSC PRO…</div>
<style>/*__CSS__*/</style>
<div id="app"></div>
<script>/*__JS__*/</script>
</body>
</html>
